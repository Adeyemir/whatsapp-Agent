# ─── Twilio WhatsApp ───────────────────────────────────────────────────────────
# 1. Set up a Twilio account at https://www.twilio.com
# 2. Console → Account Info → copy Account SID & Auth Token
# 3. Go to Messaging → Try it out → Send a WhatsApp message (Sandbox)
# 4. The sandbox number is always whatsapp:+14155238886 (Twilio's shared number)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Your own WhatsApp number, including the whatsapp: prefix. Required for webhook access.
OWNER_WHATSAPP_NUMBER=whatsapp:+2348000000000

# ─── OpenRouter (LLM) ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Web Search ────────────────────────────────────────────────────────────────
# Web search is paid per call through the Circle x402 marketplace (no key needed).
# Searches at or under SEARCH_MAX_AUTO_USDC can pay automatically.
# Pricier searches need the separate marketplace approval flow.
SEARCH_SERVICE_URL=https://api.aisa.one/apis/v2/tavily/search
SEARCH_MAX_AUTO_USDC=0.05
# Upper limit for one new marketplace service call, even after a WhatsApp yes.
MARKETPLACE_MAX_USDC_PER_CALL=0.25
# Optional Brave Search API key. When set, Friday tries Brave before paid search.
BRAVE_SEARCH_API_KEY=

# ─── Agent Behaviour ───────────────────────────────────────────────────────────
AGENT_NAME=Friday
MAX_HISTORY_MESSAGES=20

# The model has no arbitrary shell-command tool.
